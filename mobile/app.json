{
  "expo": {
    "name": "Taleora",
    "slug": "taleora",
    "version": "1.0.0",
    "runtimeVersion": "1.0.0",
    "scheme": "taleora",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "jsEngine": "hermes",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b0f17"
    },
    "updates": {
      "url": "https://u.expo.dev/taleora"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.taleora.mobile",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0b0f17"
      },
      "package": "com.taleora.mobile",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-status-bar"
    ]
  }
}
