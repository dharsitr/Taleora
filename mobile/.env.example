# Taleora Mobile Environment Configuration
# EXPO_PUBLIC_ variables are bundled with the mobile client

EXPO_PUBLIC_APP_NAME="Taleora"
EXPO_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Modern Publishable Key (Recommended)
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_publishable_key"

# Legacy Anon Key (Supported fallback)
# EXPO_PUBLIC_SUPABASE_ANON_KEY="your-legacy-anon-key"
