# Taleora - StoryBook Environment Configuration
# Copy this file to .env.local for local development

# Public Application Settings
NEXT_PUBLIC_APP_NAME="Taleora"
NEXT_PUBLIC_APP_DESCRIPTION="A modern, immersive story and reading experience"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase Public Configuration (Safe for client-side usage with RLS)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
# Modern Publishable Key (Recommended)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_publishable_key"
# Legacy Anon Key (Supported fallback)
# NEXT_PUBLIC_SUPABASE_ANON_KEY="your-legacy-anon-key"

# Server-Only Configuration (CRITICAL: NEVER expose to client or prefix with NEXT_PUBLIC_)
# Modern Secret Key (Recommended - create in Supabase Dashboard > Project Settings > API Keys)
# SUPABASE_SECRET_KEY="sb_secret_your_secret_key"
# Legacy Service Role Key (Supported fallback)
# SUPABASE_SERVICE_ROLE_KEY="your-legacy-service-role-key"
